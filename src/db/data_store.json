    {
      "id": "quiz-1",
      "classroomId": "cls-math-8a",
      "classroomName": "Grade 8 Mathematics - Sec A",
      "subject": "Mathematics",
      "title": "Algebraic Equations & Formulae Mid-Term Quiz",
      "description": "10-minute online quiz covering basic identity expansion and factorization rules.",
      "durationMinutes": 10,
      "dueDate": "2026-08-01",
      "totalQuestions": 4,
      "published": true,
      "questions": [
        {
          "id": "q1",
          "text": "What is the correct expansion for (a + b)²?",
          "type": "MCQ",
          "options": [
            "a² + b²",
            "a² + 2ab + b²",
            "a² - 2ab + b²",
            "2a + 2b"
          ],
          "correctAnswer": "a² + 2ab + b²",
          "explanation": "(a + b)² = (a + b)(a + b) = a² + ab + ba + b² = a² + 2ab + b²",
          "points": 5
        },
        {
          "id": "q2",
          "text": "Is (a² - b²) equal to (a - b)(a + b)?",
          "type": "True/False",
          "options": [
            "True",
            "False"
          ],
          "correctAnswer": "True",
          "explanation": "Difference of squares formula is (a - b)(a + b).",
          "points": 5
        },
        {
          "id": "q3",
          "text": "Factorize: x² + 5x + 6",
          "type": "MCQ",
          "options": [
            "(x + 2)(x + 3)",
            "(x + 1)(x + 6)",
            "(x - 2)(x - 3)",
            "(x + 5)(x + 1)"
          ],
          "correctAnswer": "(x + 2)(x + 3)",
          "explanation": "Find numbers that multiply to 6 and add to 5: 2 and 3.",
          "points": 5
        },
        {
          "id": "q4",
          "text": "The degree of a linear equation in one variable is 1.",
          "type": "True/False",
          "options": [
            "True",
            "False"
          ],
          "correctAnswer": "True",
          "explanation": "Linear equations have maximum exponent of 1.",
          "points": 5
        }
      ]
    },
