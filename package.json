{
  "name": "lms-workspace",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -n \"backend,frontend\" -c \"blue,green\" \"npm run dev:v -w lms-backend\" \"npm run dev -w lms-frontend\"",
    "build": "npm run build -ws",
    "lint": "tsc -b apps/frontend apps/backend packages/shared",
    "format": "prettier --write \"apps/**/*.{ts,tsx,css}\" \"packages/**/*.{ts,tsx}\"",
    "test": "npm run test --workspaces --if-present"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "concurrently": "^10.0.4",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "typescript": "~5.8.2",
    "vitest": "^4.1.10"
  }
}
