{
  "name": "lms-backend",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "NODE_ENV=development LOG_LEVEL=normal tsx server.ts",
    "dev:v": "NODE_ENV=development LOG_LEVEL=verbose tsx server.ts",
    "prod": "NODE_ENV=production LOG_LEVEL=normal node dist/server.cjs",
    "prod:v": "NODE_ENV=production LOG_LEVEL=verbose node dist/server.cjs",
    "build": "esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --log-override:empty-import-meta=silent --outfile=dist/server.cjs",
    "start": "npm run prod",
    "seed": "NODE_ENV=development tsx prisma/seed.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@dotenvx/dotenvx": "^2.20.1",
    "@google/genai": "^2.4.0",
    "@lms/shared": "*",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "bcryptjs": "^3.0.3",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "express-rate-limit": "^8.6.2",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.3",
    "node-cron": "^4.6.0",
    "pg": "^8.22.0",
    "prom-client": "^15.1.3",
    "sanitize-html": "^2.17.6",
    "swagger-ui-express": "^5.0.1",
    "ws": "^8.21.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.14.0",
    "@types/node-cron": "^3.0.11",
    "@types/pg": "^8.20.4",
    "@types/sanitize-html": "^2.16.1",
    "@types/supertest": "^7.2.1",
    "@types/swagger-ui-express": "^4.1.8",
    "@types/ws": "^8.18.1",
    "esbuild": "^0.25.0",
    "prisma": "^7.9.1",
    "supertest": "^7.2.2",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
