generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  student
  teacher
  parent
  admin
}

enum AttendanceStatus {
  present
  absent
  late
  excused
}

enum SubmissionStatus {
  pending
  draft
  submitted
  graded
  returned
  late
  overdue
}

enum QuizRevealMarksMode {
  immediate
  later
}

enum QuizAttemptStatus {
  active
  submitted
  auto_submitted
  expired
}

enum QuizStatus {
  draft
  published
  live
}

enum StudyResourceType {
  pdf
  video
  link
  image
  doc
  notes
}

enum NotificationCategory {
  CRITICAL
  ACADEMIC
  COMMUNICATION
}

enum NotificationSeverity {
  urgent
  high
  normal
  info
}

enum NotificationType {
  general
  assignment
  quiz
  attendance
  location
  announcement
  badge
  message
}

enum PaymentStatus {
  pending
  paid
  failed
  refunded
  overdue
}

enum AbsenceStatus {
  pending
  approved
  rejected
  cancelled
}

enum FileIntegrityStatus {
  verified
  scanning
  quarantined
}

enum LocationCategory {
  in_class
  canteen_lunch
  en_route_bus
  library
  sports_ground
  assembly_hall
  dismissed_home
  laboratory
}

enum StudentEnrollmentStatus {
  active
  promoted
  retained
  left
  graduated
  transferred
}

enum TeacherEmploymentStatus {
  active
  on_leave
  left
}

enum ExamStatus {
  draft
  published
  marks_open
  marks_closed
  finalized
  archived
}

enum StudentLifecycleEventType {
  enrolled
  promoted
  retained
  transferred
  left
  graduated
  restored
}

enum ReportCardResult {
  promoted
  retained
  graduated
}

model School {
  id       String @id @default(cuid())
  name     String @unique
  timezone String @default("Asia/Kathmandu")

  users               User[]
  subjects            Subject[]
  cohorts             AcademicCohort[]
  terms               AcademicTerm[]
  classrooms          Classroom[]
  academicYears       AcademicYear[]
  holidays            SchoolHoliday[]
  bellScheduleEntries BellScheduleEntry[]
  timetableSlots      TimetableSlot[]
  exams               Exam[]
  locationReporters   ExternalLocationReporter[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Subject {
  id         String  @id @default(cuid())
  schoolId   String
  school     School  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  name       String
  code       String?
  isArchived Boolean @default(false)

  teacherAssignments  TeacherSubject[]
  classrooms          Classroom[]
  performances        SubjectPerformance[]
  substituteRequests  SubstituteRequest[]
  assignmentAuditLogs TeacherAssignmentAuditLog[]
  teachingAssignments TeachingAssignment[]
  timetableSlots      TimetableSlot[]
  examSubjects        ExamSubject[]
  reportCardSubjects  StudentReportCardSubject[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([schoolId, name])
  @@index([schoolId])
}

model AcademicCohort {
  id         String @id @default(cuid())
  schoolId   String
  school     School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  gradeLevel Int
  section    String

  classrooms          Classroom[]
  studentEnrollments  StudentAcademicEnrollment[]
  timetableSlots      TimetableSlot[]
  lifecycleEventsFrom StudentLifecycleEvent[]     @relation("LifecycleEventFromCohort")
  lifecycleEventsTo   StudentLifecycleEvent[]     @relation("LifecycleEventToCohort")
  reportCards         StudentReportCard[]

  @@unique([schoolId, gradeLevel, section])
  @@index([schoolId, gradeLevel])
}

model AcademicTerm {
  id             String        @id @default(cuid())
  schoolId       String
  school         School        @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  name           String
  sequence       Int
  startsAt       DateTime?     @db.Date
  endsAt         DateTime?     @db.Date
  academicYearId String?
  academicYear   AcademicYear? @relation(fields: [academicYearId], references: [id], onDelete: Restrict)
  isArchived     Boolean       @default(false)

  progresses TermProgress[]
  exams      Exam[]

  @@index([academicYearId, sequence])
}

model AcademicYear {
  id         String   @id @default(cuid())
  schoolId   String
  school     School   @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  name       String
  startsAt   DateTime @db.Date
  endsAt     DateTime @db.Date
  isActive   Boolean  @default(false)
  isArchived Boolean  @default(false)

  terms               AcademicTerm[]
  studentEnrollments  StudentAcademicEnrollment[]
  teachingAssignments TeachingAssignment[]
  timetableSlots      TimetableSlot[]
  holidays            SchoolHoliday[]
  bellScheduleEntries BellScheduleEntry[]
  classrooms          Classroom[]
  exams               Exam[]
  lifecycleEvents     StudentLifecycleEvent[]
  reportCards         StudentReportCard[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([schoolId, name])
  @@index([schoolId, isActive, isArchived])
}

model User {
  id             String   @id @default(cuid())
  name           String
  email          String   @unique
  role           UserRole
  avatar         String
  schoolId       String
  schoolRef      School   @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  phone          String?
  secondaryPhone String?

  passwordHash  String?
  isArchived    Boolean   @default(false)
  lastSessionIp String?
  lastActiveAt  DateTime?

  studentProfile        StudentProfile?
  teacherProfile        TeacherProfile?
  parentProfile         ParentProfile?
  parentControlSettings ParentControlSettings?

  taughtClassrooms           Classroom[]                 @relation("TeacherClassrooms")
  enrollments                ClassroomEnrollment[]       @relation("StudentEnrollments")
  streamPosts                StreamPost[]                @relation("AuthorPosts")
  postComments               PostComment[]               @relation("AuthorComments")
  submissions                Submission[]                @relation("StudentSubmissions")
  quizSubmissions            QuizSubmission[]            @relation("StudentQuizSubmissions")
  quizAttemptSessions        QuizAttemptSession[]        @relation("StudentQuizAttemptSessions")
  attendanceRecords          AttendanceRecord[]          @relation("StudentAttendance")
  sentMessages               DirectMessage[]             @relation("SentMessages")
  receivedMessages           DirectMessage[]             @relation("ReceivedMessages")
  locationRecords            StudentLocationRecord[]     @relation("StudentLocations")
  subjectPerformances        SubjectPerformance[]        @relation("StudentPerformances")
  termProgresses             TermProgress[]              @relation("StudentTermProgress")
  studentActivities          StudentActivity[]           @relation("StudentActivities")
  notificationPreference     NotificationPreference?
  refreshTokens              RefreshToken[]
  parentLinks                ParentStudent[]             @relation("ParentLinks")
  guardianLinks              ParentStudent[]             @relation("StudentGuardianLinks")
  teacherSubjects            TeacherSubject[]
  substituteAssignments      ClassroomSubstitute[]
  moduleCompletions          ModuleCompletion[]
  receivedNotifications      NotificationRecord[]        @relation("NotificationRecipient")
  sentNotifications          NotificationRecord[]        @relation("NotificationSender")
  tokenRevocations           TokenRevocation[]
  securityAudits             SecurityAudit[]
  uploadedFiles              StoredFileRecord[]          @relation("FileUploader")
  studentPayments            PaymentRecord[]             @relation("StudentPayments")
  parentPayments             PaymentRecord[]             @relation("ParentPayments")
  studentAbsences            AbsenceRequest[]            @relation("StudentAbsences")
  parentAbsences             AbsenceRequest[]            @relation("ParentAbsences")
  reviewedAbsences           AbsenceRequest[]            @relation("TeacherAbsences")
  parentVerificationTokens   ParentVerificationToken[]
  updatedSystemConfigs       SystemConfig[]              @relation("ConfigUpdater")
  assignedBadges             StudentBadge[]              @relation("BadgeAssigner")
  markedAttendanceRecords    AttendanceRecord[]          @relation("AttendanceMarker")
  auditChanges               AuditTrail[]                @relation("AuditActor")
  teachingResources          StudyResource[]             @relation("TeacherResources")
  createdAssignments         Assignment[]                @relation("AssignmentCreator")
  createdQuizzes             Quiz[]                      @relation("QuizCreator")
  createdModules             ModuleItem[]                @relation("ModuleCreator")
  locationUpdates            StudentLocationRecord[]     @relation("LocationUpdater")
  teacherAbsencesSubmitted   TeacherAbsenceRequest[]     @relation("TeacherAbsencesSubmitted")
  reviewedTeacherAbsences    TeacherAbsenceRequest[]     @relation("AdminReviewedTeacherAbsences")
  originalSubstitutes        SubstituteRequest[]         @relation("OriginalTeacherSubstitutes")
  suggestedSubstitutes       SubstituteRequest[]         @relation("SuggestedTeacherSubstitutes")
  assignedSubstitutes        SubstituteRequest[]         @relation("AssignedTeacherSubstitutes")
  createdSubstitutes         SubstituteRequest[]         @relation("CreatedSubstituteRequests")
  actorAssignmentLogs        TeacherAssignmentAuditLog[] @relation("AuditActorAssignments")
  targetAssignmentLogs       TeacherAssignmentAuditLog[] @relation("AuditTargetTeachers")
  studentAcademicEnrollments StudentAcademicEnrollment[] @relation("StudentAcademicEnrollments")
  teacherTeachingAssignments TeachingAssignment[]        @relation("TeacherTeachingAssignments")
  lifecycleEvents            StudentLifecycleEvent[]     @relation("StudentLifecycleEvents")
  lifecycleEventsCreated     StudentLifecycleEvent[]     @relation("LifecycleEventCreator")
  studentExamMarks           ExamMark[]                  @relation("StudentExamMarks")
  submittedExamMarks         ExamMark[]                  @relation("ExamMarkSubmitter")
  studentReportCards         StudentReportCard[]         @relation("StudentReportCards")
  timetableSlots             TimetableSlot[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([schoolId, role, isArchived])
}

model ParentStudent {
  parentId     String
  parent       User      @relation("ParentLinks", fields: [parentId], references: [id], onDelete: Cascade)
  studentId    String
  student      User      @relation("StudentGuardianLinks", fields: [studentId], references: [id], onDelete: Cascade)
  relationship String    @default("guardian")
  isPrimary    Boolean   @default(false)
  isActive     Boolean   @default(true)
  endedAt      DateTime?
  createdAt    DateTime  @default(now())

  @@id([parentId, studentId])
  @@index([studentId, isPrimary])
}

model TeacherSubject {
  teacherId String
  teacher   User    @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  subjectId String
  subject   Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@id([teacherId, subjectId])
  @@index([subjectId])
}

model StudentProfile {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  streakDays      Int
  xpPoints        Int
  isArchived      Boolean   @default(false)
  lastStreakDate  DateTime?
  idCardPhotoUrl  String?
  admissionNumber String?
  admittedAt      DateTime  @default(now()) @db.Date
  leftAt          DateTime? @db.Date
  dateOfBirth     DateTime? @db.Date
  gender          String?
  bloodGroup      String?
  medicalNotes    String?

  badges StudentBadge[]

  @@index([isArchived])
}

model ParentProfile {
  id                 String    @id @default(cuid())
  userId             String    @unique
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  address            String?
  occupation         String?
  verificationStatus String    @default("pending")
  verifiedAt         DateTime?

  @@index([verificationStatus])
}

model TeacherProfile {
  id                    String                  @id @default(cuid())
  userId                String                  @unique
  user                  User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  employeeNumber        String?
  joinedAt              DateTime                @default(now()) @db.Date
  leftAt                DateTime?               @db.Date
  employmentStatus      TeacherEmploymentStatus @default(active)
  address               String?
  emergencyContactName  String?
  emergencyContactPhone String?
  qualification         String?
  specialization        String?

  @@index([employmentStatus])
}

model StudentAcademicEnrollment {
  id             String                  @id @default(cuid())
  studentId      String
  student        User                    @relation("StudentAcademicEnrollments", fields: [studentId], references: [id], onDelete: Restrict)
  cohortId       String
  cohort         AcademicCohort          @relation(fields: [cohortId], references: [id], onDelete: Restrict)
  academicYearId String
  academicYear   AcademicYear            @relation(fields: [academicYearId], references: [id], onDelete: Restrict)
  rollNumber     Int
  status         StudentEnrollmentStatus @default(active)
  enrolledAt     DateTime                @default(now())
  endedAt        DateTime?
  exitReason     String?

  @@unique([studentId, academicYearId])
  @@unique([academicYearId, cohortId, rollNumber])
  @@index([cohortId, academicYearId, status])
  @@index([studentId, status])
}

model StudentLifecycleEvent {
  id             String                    @id @default(cuid())
  studentId      String
  student        User                      @relation("StudentLifecycleEvents", fields: [studentId], references: [id], onDelete: Restrict)
  type           StudentLifecycleEventType
  fromCohortId   String?
  fromCohort     AcademicCohort?           @relation("LifecycleEventFromCohort", fields: [fromCohortId], references: [id], onDelete: SetNull)
  toCohortId     String?
  toCohort       AcademicCohort?           @relation("LifecycleEventToCohort", fields: [toCohortId], references: [id], onDelete: SetNull)
  academicYearId String?
  academicYear   AcademicYear?             @relation(fields: [academicYearId], references: [id], onDelete: SetNull)
  reason         String?
  metadata       Json?
  createdById    String?
  createdBy      User?                     @relation("LifecycleEventCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt      DateTime                  @default(now())

  @@index([studentId, createdAt])
  @@index([academicYearId, type])
}

model BadgeDefinition {
  id          String  @id @default(cuid())
  title       String
  description String
  icon        String
  category    String
  isAutomatic Boolean @default(false)
  criteria    String?

  studentBadges StudentBadge[]
}

model StudentBadge {
  id           String  @id @default(cuid())
  earnedDate   String
  assignedById String?
  assignedBy   User?   @relation("BadgeAssigner", fields: [assignedById], references: [id], onDelete: SetNull)
  remarks      String?

  badgeDefinitionId String
  badgeDefinition   BadgeDefinition @relation(fields: [badgeDefinitionId], references: [id], onDelete: Cascade)

  studentProfileId String
  studentProfile   StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)

  @@index([assignedById])
}

model Classroom {
  id         String         @id @default(cuid())
  name       String
  schoolId   String
  schoolRef  School         @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  subjectId  String
  subjectRef Subject        @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  cohortId   String
  cohortRef  AcademicCohort @relation(fields: [cohortId], references: [id], onDelete: Restrict)

  teacherId      String
  teacher        User          @relation("TeacherClassrooms", fields: [teacherId], references: [id], onDelete: Cascade)
  roomNumber     String
  colorTheme     String
  bannerImage    String
  meetLink       String?
  code           String        @unique
  maxCapacity    Int           @default(40)
  isArchived     Boolean       @default(false)
  academicYearId String?
  academicYear   AcademicYear? @relation(fields: [academicYearId], references: [id], onDelete: Restrict)

  enrollments         ClassroomEnrollment[]
  streamPosts         StreamPost[]
  assignments         Assignment[]
  quizzes             Quiz[]
  moduleItems         ModuleItem[]
  storedFiles         StoredFileRecord[]
  substitutes         ClassroomSubstitute[]
  resources           StudyResource[]
  substituteRequests  SubstituteRequest[]
  assignmentAuditLogs TeacherAssignmentAuditLog[]
  teachingAssignments TeachingAssignment[]
  timetableSlots      TimetableSlot[]
  examSubjects        ExamSubject[]

  @@index([schoolId, cohortId])
  @@index([teacherId])
  @@index([subjectId])
  @@index([academicYearId, isArchived])
}

model ClassroomSubstitute {
  classroomId String
  classroom   Classroom @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  teacherId   String
  teacher     User      @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  assignedAt  DateTime  @default(now())

  @@id([classroomId, teacherId])
  @@index([teacherId])
}

model ClassroomEnrollment {
  id          String    @id @default(cuid())
  classroomId String
  classroom   Classroom @relation(fields: [classroomId], references: [id], onDelete: Cascade)

  studentId String
  student   User   @relation("StudentEnrollments", fields: [studentId], references: [id], onDelete: Cascade)

  enrolledAt DateTime  @default(now())
  endedAt    DateTime?
  isActive   Boolean   @default(true)

  @@unique([classroomId, studentId])
  @@index([studentId, isActive])
}

model TeachingAssignment {
  id             String       @id @default(cuid())
  teacherId      String
  teacher        User         @relation("TeacherTeachingAssignments", fields: [teacherId], references: [id], onDelete: Restrict)
  classroomId    String
  classroom      Classroom    @relation(fields: [classroomId], references: [id], onDelete: Restrict)
  subjectId      String
  subject        Subject      @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  academicYearId String
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Restrict)
  startsAt       DateTime     @default(now()) @db.Date
  endsAt         DateTime?    @db.Date
  isActive       Boolean      @default(true)

  @@unique([teacherId, classroomId, academicYearId])
  @@index([teacherId, academicYearId, isActive])
  @@index([classroomId, isActive])
}

model TimetableSlot {
  id             String         @id @default(cuid())
  schoolId       String
  school         School         @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  academicYearId String
  academicYear   AcademicYear   @relation(fields: [academicYearId], references: [id], onDelete: Restrict)
  classroomId    String
  classroom      Classroom      @relation(fields: [classroomId], references: [id], onDelete: Restrict)
  cohortId       String
  cohort         AcademicCohort @relation(fields: [cohortId], references: [id], onDelete: Restrict)
  subjectId      String
  subject        Subject        @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  teacherId      String
  teacher        User           @relation(fields: [teacherId], references: [id], onDelete: Restrict)
  dayOfWeek      Int
  periodNumber   Int
  startTime      String
  endTime        String
  roomNumber     String
  requiredBooks  String?
  isArchived     Boolean        @default(false)

  @@index([schoolId, academicYearId, dayOfWeek, periodNumber])
  @@index([classroomId, isArchived])
}

model BellScheduleEntry {
  id             String       @id @default(cuid())
  schoolId       String
  school         School       @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  academicYearId String
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Restrict)
  name           String
  type           String
  sequence       Int
  startTime      String
  endTime        String?
  isArchived     Boolean      @default(false)

  @@index([schoolId, academicYearId, isArchived])
}

model SchoolHoliday {
  id             String       @id @default(cuid())
  schoolId       String
  school         School       @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  academicYearId String
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Restrict)
  name           String
  date           DateTime     @db.Date
  description    String?
  isArchived     Boolean      @default(false)

  @@unique([schoolId, date])
  @@index([academicYearId, isArchived, date])
}

model Exam {
  id             String        @id @default(cuid())
  schoolId       String
  school         School        @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  academicYearId String
  academicYear   AcademicYear  @relation(fields: [academicYearId], references: [id], onDelete: Restrict)
  termId         String?
  term           AcademicTerm? @relation(fields: [termId], references: [id], onDelete: Restrict)
  name           String
  status         ExamStatus    @default(draft)
  startsAt       DateTime      @db.Date
  endsAt         DateTime      @db.Date
  publishedAt    DateTime?

  subjects ExamSubject[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([academicYearId, name])
  @@index([schoolId, academicYearId, status])
}

model ExamSubject {
  id          String     @id @default(cuid())
  examId      String
  exam        Exam       @relation(fields: [examId], references: [id], onDelete: Cascade)
  subjectId   String
  subject     Subject    @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  classroomId String?
  classroom   Classroom? @relation(fields: [classroomId], references: [id], onDelete: Restrict)
  examDate    DateTime?  @db.Date
  startTime   String?
  endTime     String?
  totalMarks  Float
  passMarks   Float
  marksDueAt  DateTime?

  marks ExamMark[]

  @@unique([examId, subjectId, classroomId])
  @@index([classroomId, examDate])
}

model ExamMark {
  id            String      @id @default(cuid())
  examSubjectId String
  examSubject   ExamSubject @relation(fields: [examSubjectId], references: [id], onDelete: Cascade)
  studentId     String
  student       User        @relation("StudentExamMarks", fields: [studentId], references: [id], onDelete: Restrict)
  marksObtained Float?
  isAbsent      Boolean     @default(false)
  remarks       String?
  submittedById String
  submittedBy   User        @relation("ExamMarkSubmitter", fields: [submittedById], references: [id], onDelete: Restrict)
  submittedAt   DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@unique([examSubjectId, studentId])
  @@index([studentId, submittedAt])
  @@index([submittedById, submittedAt])
}

model StudentReportCard {
  id                   String           @id @default(cuid())
  studentId            String
  student              User             @relation("StudentReportCards", fields: [studentId], references: [id], onDelete: Restrict)
  academicYearId       String
  academicYear         AcademicYear     @relation(fields: [academicYearId], references: [id], onDelete: Restrict)
  cohortId             String
  cohort               AcademicCohort   @relation(fields: [cohortId], references: [id], onDelete: Restrict)
  finalPercentage      Float
  finalGrade           String
  attendancePercentage Float
  result               ReportCardResult
  snapshot             Json
  generatedAt          DateTime         @default(now())

  subjects StudentReportCardSubject[]

  @@unique([studentId, academicYearId])
  @@index([academicYearId, cohortId])
}

model StudentReportCardSubject {
  id            String            @id @default(cuid())
  reportCardId  String
  reportCard    StudentReportCard @relation(fields: [reportCardId], references: [id], onDelete: Cascade)
  subjectId     String
  subject       Subject           @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  percentage    Float
  grade         String
  teacherRemark String?

  @@unique([reportCardId, subjectId])
  @@index([subjectId])
}

model StreamPost {
  id          String    @id @default(cuid())
  classroomId String
  classroom   Classroom @relation(fields: [classroomId], references: [id], onDelete: Cascade)

  authorId String
  author   User    @relation("AuthorPosts", fields: [authorId], references: [id], onDelete: Restrict)
  content  String
  pinned   Boolean @default(false)

  createdAt String

  attachments Attachment[]
  comments    PostComment[]
}

model PostComment {
  id           String     @id @default(cuid())
  streamPostId String
  streamPost   StreamPost @relation(fields: [streamPostId], references: [id], onDelete: Cascade)

  authorId String
  author   User   @relation("AuthorComments", fields: [authorId], references: [id], onDelete: Restrict)
  content  String

  createdAt String
}

model Attachment {
  id    String  @id @default(cuid())
  title String
  type  String
  url   String
  size  String?

  streamPostId String?
  streamPost   StreamPost? @relation(fields: [streamPostId], references: [id], onDelete: Cascade)

  assignmentId String?
  assignment   Assignment? @relation(fields: [assignmentId], references: [id], onDelete: Cascade)

  moduleItemId String?
  moduleItem   ModuleItem? @relation(fields: [moduleItemId], references: [id], onDelete: Cascade)
}

model ModuleItem {
  id              String             @id @default(cuid())
  classroomId     String
  classroom       Classroom          @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  createdById     String
  createdBy       User               @relation("ModuleCreator", fields: [createdById], references: [id], onDelete: Restrict)
  unitName        String
  title           String
  description     String
  durationMinutes Int
  attachments     Attachment[]
  completions     ModuleCompletion[]
}

model ModuleCompletion {
  moduleItemId String
  moduleItem   ModuleItem @relation(fields: [moduleItemId], references: [id], onDelete: Cascade)
  studentId    String
  student      User       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  completedAt  DateTime   @default(now())

  @@id([moduleItemId, studentId])
  @@index([studentId])
}

model Assignment {
  id           String    @id @default(cuid())
  classroomId  String
  classroom    Classroom @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  createdById  String
  createdBy    User      @relation("AssignmentCreator", fields: [createdById], references: [id], onDelete: Restrict)
  title        String
  instructions String
  dueDate      String
  dueTime      String
  totalPoints  Int
  rubric       String[]

  createdAt String

  attachments Attachment[]
  submissions Submission[]
}

model Submission {
  id           String     @id @default(cuid())
  assignmentId String
  assignment   Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)

  studentId String
  student   User   @relation("StudentSubmissions", fields: [studentId], references: [id], onDelete: Restrict)

  status          SubmissionStatus
  fileUrl         String?
  fileName        String?
  responseText    String?
  grade           Float?
  feedback        String?
  annotated       Boolean          @default(false)
  similarityScore Float?

  submittedAt String
  versions    HomeworkVersion[]

  @@unique([assignmentId, studentId])
  @@index([studentId, status])
}

model Quiz {
  id              String              @id @default(cuid())
  classroomId     String
  classroom       Classroom           @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  createdById     String
  createdBy       User                @relation("QuizCreator", fields: [createdById], references: [id], onDelete: Restrict)
  title           String
  description     String
  durationMinutes Int
  dueDate         String
  published       Boolean             @default(false)
  revealMarksMode QuizRevealMarksMode @default(immediate)
  maxAttempts     Int                 @default(1)
  availableFrom   DateTime?
  closesAt        DateTime?
  status          QuizStatus          @default(draft)
  liveStartedAt   DateTime?           @db.Timestamptz(3)

  createdAt String

  questions     QuizQuestion[]
  submissions   QuizSubmission[]
  sessions      QuizAttemptSession[]
  resourceLinks QuizResourceLink[]
}

model QuizQuestion {
  id     String @id @default(cuid())
  quizId String
  quiz   Quiz   @relation(fields: [quizId], references: [id], onDelete: Cascade)

  text          String
  type          String
  options       String[]
  correctAnswer String
  explanation   String
  points        Int
}

model QuizSubmission {
  id     String @id @default(cuid())
  quizId String
  quiz   Quiz   @relation(fields: [quizId], references: [id], onDelete: Cascade)

  studentId        String
  student          User      @relation("StudentQuizSubmissions", fields: [studentId], references: [id], onDelete: Cascade)
  score            Float
  totalPoints      Int
  completedAt      String
  startedAt        DateTime? @db.Timestamptz(3)
  timeSpentSeconds Int?

  answers       Json
  attemptNumber Int   @default(1)
  questionOrder Json?

  @@unique([quizId, studentId, attemptNumber])
  @@index([studentId, completedAt])
}

model StudyResource {
  id            String             @id @default(cuid())
  classroomId   String
  classroom     Classroom          @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  teacherId     String
  teacher       User               @relation("TeacherResources", fields: [teacherId], references: [id], onDelete: Cascade)
  title         String
  description   String?
  type          StudyResourceType
  url           String
  mimeType      String?
  sizeFormatted String?
  tags          String[]           @default([])
  createdAt     DateTime           @default(now()) @db.Timestamptz(3)
  quizLinks     QuizResourceLink[]

  @@index([classroomId, createdAt])
  @@index([teacherId, createdAt])
}

model QuizResourceLink {
  quizId     String
  quiz       Quiz          @relation(fields: [quizId], references: [id], onDelete: Cascade)
  resourceId String
  resource   StudyResource @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  @@id([quizId, resourceId])
  @@index([resourceId])
}

model QuizAttemptSession {
  id            String            @id @default(cuid())
  quizId        String
  quiz          Quiz              @relation(fields: [quizId], references: [id], onDelete: Cascade)
  studentId     String
  student       User              @relation("StudentQuizAttemptSessions", fields: [studentId], references: [id], onDelete: Cascade)
  answers       Json              @default("{}")
  questionOrder Json
  attemptNumber Int
  status        QuizAttemptStatus @default(active)
  startedAt     DateTime          @default(now())
  deadlineAt    DateTime
  submittedAt   DateTime?

  @@index([status, deadlineAt])
  @@index([studentId, quizId])
}

model AttendanceRecord {
  id          String           @id @default(cuid())
  studentId   String
  student     User             @relation("StudentAttendance", fields: [studentId], references: [id], onDelete: Restrict)
  date        String
  status      AttendanceStatus
  markedById  String
  markedBy    User             @relation("AttendanceMarker", fields: [markedById], references: [id], onDelete: Restrict)
  remarks     String?
  checkInTime String?

  @@unique([studentId, date])
  @@index([studentId, date])
  @@index([markedById])
}

model ParentControlSettings {
  id        String @id @default(cuid())
  studentId String @unique
  user      User   @relation(fields: [studentId], references: [id], onDelete: Cascade)

  allowTeacherDirectChat         Boolean
  allowPeerDiscussion            Boolean
  missingHomeworkAlerts          Boolean
  lowAttendanceAlerts            Boolean
  weeklyDigestEmail              Boolean
  screenTimeLimitMinutes         Int
  requireApprovalForOutboundMsgs Boolean
  blackoutStart                  String?
  blackoutEnd                    String?
  timezone                       String  @default("Asia/Kathmandu")
}

model DirectMessage {
  id               String   @id @default(cuid())
  senderId         String
  sender           User     @relation("SentMessages", fields: [senderId], references: [id], onDelete: Restrict)
  receiverId       String
  receiver         User     @relation("ReceivedMessages", fields: [receiverId], references: [id], onDelete: Restrict)
  content          String
  read             Boolean  @default(false)
  approvedByParent Boolean?

  createdAt String
}

model SubjectPerformance {
  id                   String  @id @default(cuid())
  studentId            String
  student              User    @relation("StudentPerformances", fields: [studentId], references: [id], onDelete: Cascade)
  subjectId            String
  subjectRef           Subject @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  scorePercentage      Float
  grade                String
  assignmentsCompleted Int
  totalAssignments     Int
  quizzesScoreAvg      Float
  teacherRemark        String

  @@unique([studentId, subjectId])
  @@index([subjectId])
}

model StoredFileRecord {
  id              String              @id @default(cuid())
  originalName    String
  storedName      String
  mimeType        String
  sizeBytes       Int
  uploadedById    String
  uploader        User                @relation("FileUploader", fields: [uploadedById], references: [id], onDelete: Restrict)
  classroomId     String?
  classroom       Classroom?          @relation(fields: [classroomId], references: [id], onDelete: SetNull)
  checksum        String
  integrityStatus FileIntegrityStatus
  downloadUrl     String

  uploadedAt String
}

model StudentLocationRecord {
  id                 String                    @id @default(cuid())
  studentId          String                    @unique
  student            User                      @relation("StudentLocations", fields: [studentId], references: [id], onDelete: Restrict)
  currentLocation    String
  category           LocationCategory
  busNumber          String?
  updatedById        String?
  updater            User?                     @relation("LocationUpdater", fields: [updatedById], references: [id], onDelete: SetNull)
  externalReporterId String?
  externalReporter   ExternalLocationReporter? @relation(fields: [externalReporterId], references: [id], onDelete: SetNull)
  notes              String?
  latitude           Float?
  longitude          Float?

  updatedAt String

  @@index([updatedById])
  @@index([externalReporterId])
}

model ExternalLocationReporter {
  id       String @id @default(cuid())
  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  name     String
  role     String

  locationRecords StudentLocationRecord[]

  @@unique([schoolId, name])
  @@index([schoolId])
}

model TermProgress {
  id        String       @id @default(cuid())
  studentId String
  student   User         @relation("StudentTermProgress", fields: [studentId], references: [id], onDelete: Cascade)
  termId    String
  termRef   AcademicTerm @relation(fields: [termId], references: [id], onDelete: Restrict)
  score     Float

  @@unique([studentId, termId])
  @@index([termId])
}

model StudentActivity {
  id          String @id @default(cuid())
  studentId   String
  student     User   @relation("StudentActivities", fields: [studentId], references: [id], onDelete: Cascade)
  title       String
  category    String
  position    String
  date        String
  description String
}

model NotificationRecord {
  id             String               @id @default(cuid())
  recipientId    String
  recipient      User                 @relation("NotificationRecipient", fields: [recipientId], references: [id], onDelete: Restrict)
  senderId       String?
  sender         User?                @relation("NotificationSender", fields: [senderId], references: [id], onDelete: SetNull)
  title          String
  body           String
  category       NotificationCategory @default(COMMUNICATION)
  severity       NotificationSeverity @default(normal)
  type           NotificationType     @default(general)
  broadcastId    String?
  targetAudience String?
  read           Boolean              @default(false)
  createdAt      String

  @@index([recipientId, read, createdAt])
  @@index([senderId])
  @@index([broadcastId])
}

model NotificationPreference {
  id                  String  @id @default(cuid())
  userId              String  @unique
  user                User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  enableAcademic      Boolean @default(true)
  enableCommunication Boolean @default(true)
  enableReminders     Boolean @default(true)
}

model RefreshToken {
  id                String         @id @default(cuid())
  userId            String
  user              User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash         String         @unique
  deviceFingerprint String
  ipAddress         String?
  expiresAt         DateTime
  revokedAt         DateTime?
  replacedById      String?        @unique
  replacedBy        RefreshToken?  @relation("RefreshTokenReplacement", fields: [replacedById], references: [id], onDelete: SetNull)
  replaces          RefreshToken[] @relation("RefreshTokenReplacement")
  createdAt         DateTime       @default(now())

  @@index([userId, expiresAt])
}

model TokenRevocation {
  id        String   @id @default(cuid())
  jti       String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  reason    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId, expiresAt])
}

model SecurityAudit {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  event     String
  severity  String   @default("warning")
  ipAddress String?
  requestId String?
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

model AuditTrail {
  id           String   @id @default(cuid())
  tableName    String
  action       String
  previousData Json?
  newData      Json?
  changedBy    String?
  actor        User?    @relation("AuditActor", fields: [changedBy], references: [id], onDelete: SetNull)
  category     String   @default("database")
  createdAt    DateTime @default(now())

  @@index([changedBy, category, createdAt])
  @@map("AuditTrail")
}

model HomeworkVersion {
  id           String     @id @default(cuid())
  submissionId String
  submission   Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  version      Int
  fileUrl      String?
  fileName     String?
  responseText String?
  createdAt    DateTime   @default(now())

  @@unique([submissionId, version])
}

model PaymentRecord {
  id          String        @id @default(cuid())
  studentId   String
  student     User          @relation("StudentPayments", fields: [studentId], references: [id], onDelete: Restrict)
  parentId    String
  parent      User          @relation("ParentPayments", fields: [parentId], references: [id], onDelete: Restrict)
  invoiceNo   String        @unique
  amount      Decimal       @db.Decimal(12, 2)
  currency    String        @default("NPR")
  status      PaymentStatus
  description String
  paidAt      DateTime?
  createdAt   DateTime      @default(now())

  @@index([studentId, createdAt])
  @@index([parentId, createdAt])
}

model AbsenceRequest {
  id        String        @id @default(cuid())
  studentId String
  student   User          @relation("StudentAbsences", fields: [studentId], references: [id], onDelete: Restrict)
  parentId  String
  parent    User          @relation("ParentAbsences", fields: [parentId], references: [id], onDelete: Restrict)
  teacherId String?
  teacher   User?         @relation("TeacherAbsences", fields: [teacherId], references: [id], onDelete: SetNull)
  startDate DateTime
  endDate   DateTime
  reason    String
  status    AbsenceStatus @default(pending)
  createdAt DateTime      @default(now())

  @@index([studentId, status])
  @@index([parentId, status])
  @@index([teacherId, status])
}

model ParentVerificationToken {
  id        String    @id @default(cuid())
  parentId  String
  parent    User      @relation(fields: [parentId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([parentId, expiresAt])
}

model SystemConfig {
  key         String   @id
  value       Json
  description String?
  updatedBy   String?
  updater     User?    @relation("ConfigUpdater", fields: [updatedBy], references: [id], onDelete: SetNull)
  updatedAt   DateTime @updatedAt
}

model ApiKey {
  id         String    @id @default(cuid())
  name       String
  keyHash    String    @unique
  scopes     String[]
  active     Boolean   @default(true)
  lastUsedAt DateTime?
  expiresAt  DateTime?
  createdAt  DateTime  @default(now())
}

model TeacherAbsenceRequest {
  id                String        @id @default(cuid())
  teacherId         String
  teacher           User          @relation("TeacherAbsencesSubmitted", fields: [teacherId], references: [id], onDelete: Cascade)
  startDate         DateTime
  endDate           DateTime
  reason            String
  status            AbsenceStatus @default(pending)
  reviewedByAdminId String?
  reviewedByAdmin   User?         @relation("AdminReviewedTeacherAbsences", fields: [reviewedByAdminId], references: [id], onDelete: SetNull)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  substituteRequests SubstituteRequest[]

  @@index([teacherId, status])
  @@index([reviewedByAdminId])
}

enum SubstituteRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

model SubstituteRequest {
  id                      String                  @id @default(cuid())
  teacherAbsenceRequestId String?
  teacherAbsenceRequest   TeacherAbsenceRequest?  @relation(fields: [teacherAbsenceRequestId], references: [id], onDelete: SetNull)
  classroomId             String
  classroom               Classroom               @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  subjectId               String
  subject                 Subject                 @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  date                    String
  timeSlot                String
  originalTeacherId       String
  originalTeacher         User                    @relation("OriginalTeacherSubstitutes", fields: [originalTeacherId], references: [id], onDelete: Cascade)
  suggestedSubstituteId   String?
  suggestedSubstitute     User?                   @relation("SuggestedTeacherSubstitutes", fields: [suggestedSubstituteId], references: [id], onDelete: SetNull)
  assignedSubstituteId    String?
  assignedSubstitute      User?                   @relation("AssignedTeacherSubstitutes", fields: [assignedSubstituteId], references: [id], onDelete: SetNull)
  reason                  String
  status                  SubstituteRequestStatus @default(PENDING)
  responseNotes           String?
  createdByAdminId        String
  createdByAdmin          User                    @relation("CreatedSubstituteRequests", fields: [createdByAdminId], references: [id], onDelete: Cascade)
  createdAt               DateTime                @default(now())
  updatedAt               DateTime                @updatedAt

  @@index([classroomId, date])
  @@index([originalTeacherId, status])
  @@index([assignedSubstituteId, status])
}

model TeacherAssignmentAuditLog {
  id              String     @id @default(cuid())
  actorId         String
  actor           User       @relation("AuditActorAssignments", fields: [actorId], references: [id], onDelete: Restrict)
  targetTeacherId String
  targetTeacher   User       @relation("AuditTargetTeachers", fields: [targetTeacherId], references: [id], onDelete: Restrict)
  action          String
  subjectId       String?
  subject         Subject?   @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  classroomId     String?
  classroom       Classroom? @relation(fields: [classroomId], references: [id], onDelete: SetNull)
  details         String
  reason          String?
  createdAt       DateTime   @default(now())

  @@index([targetTeacherId, createdAt])
  @@index([actorId, createdAt])
}
