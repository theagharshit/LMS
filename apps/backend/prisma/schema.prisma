generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  student
  teacher
  parent
  admin
}

model User {
  id          String   @id @default(cuid())
  name        String
  email       String   @unique
  role        UserRole
  avatar      String
  schoolName  String
  
  gradeLevel  Int?
  section     String?
  rollNumber  Int?

  childrenIds String[]

  subjectsTaught String[]
  
  studentProfile StudentProfile?
  parentControlSettings ParentControlSettings?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model StudentProfile {
  id                   String @id @default(cuid())
  userId               String @unique
  user                 User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  attendancePercentage Float
  streakDays           Int
  xpPoints             Int
  gradeLevel           Int
  section              String
  parentName           String
  parentPhone          String

  badges               StudentBadge[]
}

model BadgeDefinition {
  id          String   @id @default(cuid())
  title       String
  description String
  icon        String
  category    String
  isAutomatic Boolean  @default(false)
  criteria    String?  // JSON string for auto-assignment logic

  studentBadges StudentBadge[]
}

model StudentBadge {
  id          String   @id @default(cuid())
  earnedDate  String
  assignedBy  String?
  remarks     String?
  
  badgeDefinitionId String
  badgeDefinition   BadgeDefinition @relation(fields: [badgeDefinitionId], references: [id], onDelete: Cascade)

  studentProfileId String
  studentProfile   StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
}

model Classroom {
  id            String   @id @default(cuid())
  name          String
  subject       String
  gradeLevel    Int
  section       String
  teacherId     String
  teacherName   String
  teacherAvatar String
  roomNumber    String
  colorTheme    String
  bannerImage   String
  studentCount  Int
  meetLink      String?
  code          String   @unique
}

model StreamPost {
  id            String   @id @default(cuid())
  classroomId   String
  authorId      String
  authorName    String
  authorAvatar  String
  authorRole    UserRole
  content       String
  pinned        Boolean  @default(false)
  
  createdAt     String
  
  attachments   Attachment[]
  comments      PostComment[]
}

model PostComment {
  id           String     @id @default(cuid())
  streamPostId String
  streamPost   StreamPost @relation(fields: [streamPostId], references: [id], onDelete: Cascade)
  
  authorName   String
  authorAvatar String
  content      String
  
  createdAt    String
}

model Attachment {
  id           String      @id @default(cuid())
  title        String
  type         String 
  url          String
  size         String?
  
  streamPostId String?
  streamPost   StreamPost? @relation(fields: [streamPostId], references: [id], onDelete: Cascade)
  
  assignmentId String?
  assignment   Assignment? @relation(fields: [assignmentId], references: [id], onDelete: Cascade)

  moduleItemId String?
  moduleItem   ModuleItem? @relation(fields: [moduleItemId], references: [id], onDelete: Cascade)
}

model ModuleItem {
  id                    String       @id @default(cuid())
  classroomId           String
  unitName              String
  title                 String
  description           String
  durationMinutes       Int
  completedByStudentIds String[]

  attachments           Attachment[]
}

model Assignment {
  id            String       @id @default(cuid())
  classroomId   String
  classroomName String
  subject       String
  title         String
  instructions  String
  dueDate       String
  dueTime       String
  totalPoints   Int
  rubric        String[]
  
  createdAt     String
  
  attachments   Attachment[]
  submissions   Submission[]
}

model Submission {
  id            String     @id @default(cuid())
  assignmentId  String
  assignment    Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  
  studentId     String
  studentName   String
  studentAvatar String
  
  status        String 
  fileUrl       String?
  fileName      String?
  responseText  String?
  grade         Float?
  feedback      String?
  annotated     Boolean    @default(false)
  
  submittedAt   String 
}

model Quiz {
  id              String         @id @default(cuid())
  classroomId     String
  classroomName   String
  subject         String
  title           String
  description     String
  durationMinutes Int
  dueDate         String
  totalQuestions  Int
  published       Boolean        @default(false)
  
  createdAt       String
  
  questions       QuizQuestion[]
  submissions     QuizSubmission[]
}

model QuizQuestion {
  id            String   @id @default(cuid())
  quizId        String
  quiz          Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  
  text          String
  type          String 
  options       String[]
  correctAnswer String
  explanation   String
  points        Int
}

model QuizSubmission {
  id          String   @id @default(cuid())
  quizId      String
  quiz        Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  
  studentId   String
  score       Float
  totalPoints Int
  completedAt String
  
  answers     Json
}

model AttendanceRecord {
  id          String   @id @default(cuid())
  studentId   String
  studentName String
  date        String 
  status      String 
  markedBy    String
  remarks     String?
  checkInTime String?
}

model ParentControlSettings {
  id                             String  @id @default(cuid())
  studentId                      String  @unique
  user                           User    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  
  allowTeacherDirectChat         Boolean
  allowPeerDiscussion            Boolean
  missingHomeworkAlerts          Boolean
  lowAttendanceAlerts            Boolean
  weeklyDigestEmail              Boolean
  screenTimeLimitMinutes         Int
  requireApprovalForOutboundMsgs Boolean
}

model CalendarEvent {
  id           String  @id @default(cuid())
  title        String
  type         String 
  date         String 
  time         String?
  description  String
  subject      String?
  nepaliDateBS String?
}

model DirectMessage {
  id               String   @id @default(cuid())
  senderId         String
  senderName       String
  senderRole       UserRole
  senderAvatar     String
  receiverId       String
  receiverName     String
  content          String
  read             Boolean  @default(false)
  approvedByParent Boolean?
  
  createdAt        String
}

model SubjectPerformance {
  id                   String @id @default(cuid())
  studentId            String
  subject              String
  scorePercentage      Float
  grade                String
  assignmentsCompleted Int
  totalAssignments     Int
  quizzesScoreAvg      Float
  teacherRemark        String
}

model StoredFileRecord {
  id              String   @id @default(cuid())
  originalName    String
  storedName      String
  mimeType        String
  sizeBytes       Int
  sizeFormatted   String
  uploadedBy      String
  classroomId     String?
  checksum        String
  integrityStatus String 
  downloadUrl     String
  
  uploadedAt      String
}

model StudentLocationRecord {
  id              String   @id @default(cuid())
  studentId       String
  studentName     String
  currentLocation String
  category        String 
  busNumber       String?
  updatedBy       String
  updatedByRole   String
  notes           String?
  
  updatedAt       String
}

model TermProgress {
  id        String @id @default(cuid())
  studentId String
  term      String
  score     Float
}

model StudentActivity {
  id          String @id @default(cuid())
  studentId   String
  title       String
  category    String
  position    String
  date        String
  description String
}
